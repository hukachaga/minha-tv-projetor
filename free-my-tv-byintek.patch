diff --git a/app/src/io/freemytv/Videos.java b/app/src/io/freemytv/Videos.java
new file mode 100644
index 0000000..2077809
--- /dev/null
+++ b/app/src/io/freemytv/Videos.java
@@ -0,0 +1,135 @@
+package io.freemytv;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.BitmapShader;
+import android.graphics.Shader;
+import android.os.Handler;
+import android.os.Looper;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Byintek: the row of new videos from your YouTube subscriptions, above the shelf. The list (no Shorts, no lives,
+ * newest first) comes from the ytfeed LXC (`youtube_feed` in config.properties); each video
+ * opens in YouTube. Fetched in the background at most every 5 minutes; the thumbnails are kept at the row's size.
+ */
+final class Videos {
+    static final int MAX = 30;
+    /** Thumbnails at the focused card's size (16:9), so they draw pixel for pixel. */
+    static final int THUMB_W = 352, THUMB_H = 198;
+    private static final long EVERY = 5 * 60_000L;   // the LXC refreshes every 5 minutes too
+    private static final String YOUTUBE = "com.google.android.youtube.tv";
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final Runnable changed;
+    private volatile List<Recs.Pick> list = Collections.emptyList();
+    private final Map<String, Recs.Pick> byId = new HashMap<>();   // keeps thumbnails across refreshes
+    private long fetchedAt;
+    private boolean fetching;
+
+    Videos(Runnable changed) {
+        this.changed = changed;
+    }
+
+    static boolean on() {
+        return !Config.YOUTUBE_FEED.isEmpty();
+    }
+
+    /** The videos with their thumbnail ready, in the feed's order. */
+    List<Recs.Pick> now() {
+        return list;
+    }
+
+    void refreshIfStale() {
+        if (!on() || fetching || System.currentTimeMillis() - fetchedAt < EVERY) return;
+        fetching = true;
+        new Thread(this::fetch, "videos").start();
+    }
+
+    private void fetch() {
+        try {
+            JSONArray items = new JSONObject(new String(get(Config.YOUTUBE_FEED), "UTF-8")).getJSONArray("items");
+            List<Recs.Pick> out = new ArrayList<>();
+            for (int i = 0; i < items.length() && out.size() < MAX; i++) {
+                JSONObject o = items.getJSONObject(i);
+                String id = o.getString("id");
+                Recs.Pick p = byId.get(id);
+                if (p == null) {
+                    p = new Recs.Pick();
+                    p.kind = "youtube";
+                    p.id = id.hashCode();
+                    p.title = o.optString("title");
+                    p.app = "youtube";
+                    p.pkg = YOUTUBE;
+                    p.link = "https://www.youtube.com/watch?v=" + id;
+                    p.backdrop = o.optString("thumb");
+                    p.meta = o.optString("channel") + " · " + duration(o.optInt("duration"));
+                    try {
+                        p.thumb = thumbnail(p.backdrop);
+                        p.thumbShader = new BitmapShader(p.thumb, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP);
+                    } catch (Exception | OutOfMemoryError e) {
+                        AppLog.w("video thumbnail: " + e.getMessage());
+                        continue;
+                    }
+                }
+                out.add(p);
+            }
+            byId.clear();
+            for (Recs.Pick p : out) byId.put(p.link.substring(p.link.indexOf('=') + 1), p);
+            list = Collections.unmodifiableList(out);
+            fetchedAt = System.currentTimeMillis();
+            AppLog.w("videos: " + out.size());
+            main.post(changed);
+        } catch (Exception e) {
+            AppLog.w("videos: " + e.getMessage());
+            fetchedAt = System.currentTimeMillis() - EVERY + 60_000L;   // the LXC may be starting: again in a minute
+        } finally {
+            fetching = false;
+        }
+    }
+
+    private static String duration(int s) {
+        return s >= 3600 ? String.format(Locale.ROOT, "%d:%02d:%02d", s / 3600, s / 60 % 60, s % 60)
+                : String.format(Locale.ROOT, "%d:%02d", s / 60, s % 60);
+    }
+
+    /** The thumbnail center-cropped to 16:9 (YouTube's hqdefault has black bars) and scaled to the row's size. */
+    private static Bitmap thumbnail(String url) throws Exception {
+        byte[] data = get(url);
+        Bitmap src = BitmapFactory.decodeByteArray(data, 0, data.length);
+        if (src == null) throw new java.io.IOException("unreadable image");
+        int w = src.getWidth(), h = Math.min(src.getHeight(), Math.round(w * 9f / 16));
+        Bitmap crop = Bitmap.createBitmap(src, 0, (src.getHeight() - h) / 2, w, h);
+        Bitmap out = Ui.downscale(crop, THUMB_W, THUMB_H);
+        if (crop != src) src.recycle();
+        if (out != crop) crop.recycle();
+        return out;
+    }
+
+    private static byte[] get(String url) throws Exception {
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        c.setConnectTimeout(8000);
+        c.setReadTimeout(15000);
+        try (InputStream in = c.getInputStream()) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[16384];
+            for (int n; (n = in.read(buf)) > 0; ) out.write(buf, 0, n);
+            return out.toByteArray();
+        } finally {
+            c.disconnect();
+        }
+    }
+}
